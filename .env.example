# ==================================
# Supabase Configuration
# ==================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-secret-key-here

# ==================================
# Teams Calendar Sync (Reverse Sync: Supabase → Teams)
# ==================================
# URL of the Teams Daemon service that handles calendar synchronization
TEAMS_DAEMON_URL=https://your-teams-daemon-url.com

# Secret key for authenticating with the Teams Daemon service
# Generate a secure random string: openssl rand -hex 32
TEAMS_DAEMON_SECRET=your-teams-daemon-secret-here

# ==================================
# Setup Instructions:
# ==================================
# 1. Copy this file to .env.local: cp .env.example .env.local
# 2. Fill in the Supabase values from your Supabase project dashboard
# 3. Set up the Teams Daemon service and configure its URL
# 4. Generate a secure secret for Teams Daemon authentication
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_afl4o2t
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID_CONTACT=template_w4y6w5a
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=HtlVH2CN851UOFALn